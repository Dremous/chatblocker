{
	"schemaVersion": 1,
	"id": "chatblocker",
	"version": "${version}",
	"name": "ChatBlocker",
	"description": "聊天关键词屏蔽：别人发送的含关键词消息自己不显示，自己发送的消息不受影响。同时覆盖服务器公告等系统消息；离线服务器按文本匹配豁免自己消息的回显（可在配置中关闭）。",
	"authors": [
		"Dremous"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/chatblocker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.chatblocker.ChatBlockMod"
		],
		"modmenu": [
			"net.chatblocker.gui.ChatBlockModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.8.1"
	},
	"suggests": {
		"modmenu": ">=11.0.3"
	}
}
