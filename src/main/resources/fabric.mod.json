{
	"schemaVersion": 1,
	"id": "chatblocker",
	"version": "${version}",
	"name": "ChatBlocker",
	"description": "Chat keyword filter: hides messages from others that contain blocked keywords on your client. Your own messages are unaffected. Also covers system messages (server announcements, etc.); offline server echo exemption via text matching (configurable).",
	"authors": [
		"Dremous"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/chatblocker_",
		"sources": "https://github.com/Dremous/chatblocker",
		"issues": "https://github.com/Dremous/chatblocker/issues"
	},
	"license": "MIT",
	"icon": "assets/chatblocker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.chatblocker.ChatBlockMod"
		],
		"modmenu": [
			"net.chatblocker.gui.ChatBlockModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=3.8.1"
	},
	"suggests": {
		"modmenu": ">=15.0.2"
	}
}
